# 复制成 .env 再改。所有项都可以在网页「设置」里改，改完立即生效并写回 data/settings.json。

# ---- 大脑：任意 OpenAI 兼容服务 ----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_VISION=1
LLM_THINKING=disabled
LLM_EFFORT=low
LLM_MAX_TOKENS=320
LLM_TEMPERATURE=0.2
VISION_DETAIL=low

# 本机模型（Ollama）示例：
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5vl:7b
# LLM_API_KEY=

# ---- 眼睛 ----
CAMERA_SOURCE=mock        # mock | opencv | file
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=8

# ---- 耳朵 ----
AUDIO_SOURCE=mock         # mock | mic | file
AUDIO_DEVICE=
ASR_PROVIDER=mock         # mock | local | cloud
ASR_MODEL=small
ASR_LANGUAGE=zh
CLOUD_ASR_BASE_URL=https://api.openai.com/v1
CLOUD_ASR_API_KEY=
CLOUD_ASR_MODEL=whisper-1

# ---- 身体 ----
DRIVER=mock               # mock | ir | button | serial | none
DRIVER_BRIDGE_URL=ws://192.168.4.1:81
DRIVER_SERIAL_PORT=COM3
DRIVER_SERIAL_BAUD=115200

# ---- 主循环 ----
AUTO_MODE=0
TICK_MS=250
DECISION_INTERVAL_MS=1800
# 默认 0：永远不会用你的音箱说话。要出声自己在网页上勾「朗读」。
SPEAK_REPLY=0

# ---- 安全 ----
MAX_SPEED=0.6
MAX_DURATION_MS=2500
MIN_ACTION_INTERVAL_MS=250
WATCHDOG_MS=6000
REFLEX_ENABLED=1
REFLEX_STOP_M=0.25
ESTOP_ON_START=0

PORT=8790
